[Unit]
Description=Kapum ChatBot auto-update every 10 minutes

[Timer]
# Первая проверка после загрузки (сеть уже должна подняться), затем каждые
# 10 минут после завершения прошлой проверки. Случайный сдвиг до 2 минут размазывает
# нагрузку. OnBootSec даёт проверку после простоя/перезагрузки.
OnBootSec=5min
OnUnitInactiveSec=10min
RandomizedDelaySec=2min
AccuracySec=1min

[Install]
WantedBy=timers.target
