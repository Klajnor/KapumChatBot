[Unit]
Description=Kapum ChatBot auto-update (bot + ObsidianBrain: fetch origin/master + restart)
Documentation=file:/opt/KapumChatBot/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Запускается только таймером kapum-update.timer, поэтому без [Install].
# Root: скрипт делает git fetch/reset в /opt/KapumChatBot и /opt/brain,
# pip install в их .venv и systemctl restart chat_bot.service; сам бот и
# пользователь brain код не трогают (README, «Автообновление»).
User=root
Group=root
ExecStart=/opt/KapumChatBot/scripts/update.sh
# UMask 0022: создаваемые git/pip файлы кода должны читаться сервисным
# пользователем brain (chat_bot.service работает с UMask=0077 — это его файлы).
UMask=0022
# Таймаут pip ограничен внутри скрипта; оставляем время на копии и откат.
TimeoutStartSec=30min
TimeoutStopSec=5min
