[Unit]
Description=Kapum ChatBot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=brain
Group=brain
UMask=0077
WorkingDirectory=/opt/KapumChatBot
# Бот не пишет .pyc: отдельная очистка __pycache__ перед запуском не нужна,
# а каталог с кодом может оставаться недоступным на запись для сервиса.
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Каталоги данных и кэша создаются systemd с владельцем brain:
#   /var/lib/kapum-chatbot   — chat_bot.db (+ WAL), errors.log, telegraph_account.json и модель rembg
#   /var/cache/kapum-chatbot — кэш шрифтов matplotlib
# В .env.linux на сервере укажите абсолютные пути (относительные отклоняются):
#   DATABASE_URL=sqlite+aiosqlite:////var/lib/kapum-chatbot/chat_bot.db
#   TELEGRAPH_ACCOUNT_FILE=/var/lib/kapum-chatbot/telegraph_account.json
#   STICKER_MODEL_DIR=/var/lib/kapum-chatbot/rembg
StateDirectory=kapum-chatbot
StateDirectoryMode=0700
CacheDirectory=kapum-chatbot
CacheDirectoryMode=0700
Environment=MPLCONFIGDIR=/var/cache/kapum-chatbot/matplotlib
# Запасной путь rembg для службы без домашнего каталога. STICKER_MODEL_DIR в .env.linux имеет приоритет.
Environment=U2NET_HOME=/var/lib/kapum-chatbot/rembg
# Кэш байткода сервис не создаёт (PYTHONDONTWRITEBYTECODE=1). Старые
# root-owned __pycache__ удаляет restart.sh от root; запускать чистку от brain
# нельзя — код и кэш принадлежат root:root.
ExecStart=/opt/KapumChatBot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5s
TimeoutStopSec=30s

# Ограничения. Код в /opt/KapumChatBot остаётся root:root (сервис только
# читает); запись разрешена в StateDirectory/CacheDirectory. Если хранилище
# Obsidian для MCP лежит в /home, замените ProtectHome=true на false.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
