# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# Optional: bot username without "@". Resolved automatically at startup if empty.
BOT_USERNAME=

# ─── AI provider: Qwen (Alibaba Cloud Model Studio "Token Plan") ─────────────
# OpenAI-compatible endpoint. Only the key, base URL and model name differ from
# any other OpenAI-compatible provider.
#
# Base URLs:
#   International (Singapore, legacy): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   China (Beijing, legacy):          https://dashscope.aliyuncs.com/compatible-mode/v1
#   Workspace-specific (recommended): https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# API key created in the SAME region as the base URL (Model Studio -> API key).
# Aliases accepted: QWEN_API_KEY, DASHSCOPE_API_KEY
AI_API_KEY=your_qwen_api_key_here

# ─── Model catalog (menu /models) ────────────────────────────────────────────
# Comma- and/or newline-separated entries:
#   model-id | model-id:Display Name | model-id:Display Name:vision|novision
# ":vision" marks an image-capable model explicitly; without the flag vision
# support is detected from the id (Qwen-VL / Omni / OCR, Qwen3.5+ families).
# Models unavailable for your account are hidden automatically at startup.
AI_MODELS=qwen3.8-max:Qwen 3.8 Max:vision,qwen3.8-flash:Qwen 3.8 Flash:vision,qwen3.8-omni-flash:Qwen 3.8 Omni Flash:vision,qwen3.5-ocr:Qwen 3.5 OCR:vision,deepseek-v4-pro-0813:DeepSeek V4 Pro:novision,deepseek-v4.1-flash-1017:DeepSeek V4.1 Flash:vision

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite by default — a single file next to the bot (WAL mode is enabled
# automatically). PostgreSQL stays supported: just switch the URL (asyncpg).
# Migrate old data once: python scripts/migrate_to_sqlite.py --from <postgres-url>
DATABASE_URL=sqlite+aiosqlite:///chat_bot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chat_bot

# ─── Defaults ────────────────────────────────────────────────────────────────
DEFAULT_MODEL=qwen3.8-flash
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant. Answer questions concisely and accurately.
DEFAULT_TEMPERATURE=0.7
# Response token limit for all users, including existing database accounts.
# Changes take effect after restarting the bot.
DEFAULT_MAX_TOKENS=2048
REQUEST_TIMEOUT=300
# Reply formatting on the LEGACY fallback path: markdown | html | plain.
# Ignored for rich messages: the model's Markdown is passed to Telegram as-is.
PARSE_MODE=markdown

# ─── Formulas & answer style ─────────────────────────────────────────────────
# With RICH_MESSAGES=true (the primary delivery mode configured in this file)
# Telegram renders the model's Markdown natively: $…$ and $$…$$ become real
# formulas, | tables | become tables — nothing is rewritten or rasterised.
# The knobs below shape only the LEGACY fallback path (rich disabled, or a
# rich send rejected by Telegram):
#   H_2SO_4 -> H₂SO₄ | \alpha -> α | 10^{23} -> 10²³ | \frac{s}{t} -> s/t
# Fenced code blocks and `inline code` are never touched, and identifiers such
# as user_name / MAX_VALUE / item_1 are left intact.
NORMALIZE_FORMULAS=true
# Render display math (\[...\] or $$...$$) locally as PNG on the legacy path.
# Requires matplotlib from requirements.txt; no LaTeX installation is needed.
# Set false to send all formulas as text. Default: true.
RENDER_FORMULA_IMAGES=true
# Additionally ask the model (through the system prompt) how to format answers.
# With STYLE_HINT empty the built-in instruction is picked automatically to
# match the delivery mode: rich (tables and $$LaTeX$$ welcome) or legacy
# (Unicode notation, no tables). A custom value overrides both defaults.
ENABLE_STYLE_HINT=true
STYLE_HINT=

# ─── Slow requests: live "waiting" message ───────────────────────────────────
# If a request to the model takes longer than PROGRESS_DELAY seconds, the bot
# posts a notice and refreshes it every PROGRESS_INTERVAL seconds until the
# answer arrives; the notice is deleted right before the reply is sent (with
# STREAM_RESPONSES=true — as soon as the first draft/placeholder update comes).
# Faster answers produce no extra message at all.
ENABLE_PROGRESS=true
PROGRESS_DELAY=5
PROGRESS_INTERVAL=5
# Placeholders: {spinner} = animated frame, {seconds} = elapsed seconds.
PROGRESS_TEXT={spinner} Waiting for the AI response… {seconds} s
# Minimum seconds between two outgoing messages in the same chat. Telegram
# allows ~1 message per second per chat; set 0 to disable the throttle.
SEND_MIN_INTERVAL=1.25

# ─── Timing footer ───────────────────────────────────────────────────────────
# Append the AI API processing time to every answer (on the rich path it
# becomes a plain text line inside the same rich message).
# Placeholders: {seconds}, {model}, {tokens} (token counter, if the API reports it).
SHOW_TIMING=true
TIMING_FORMAT=⏱️ {seconds} s · {model}

# ─── Voice (speech recognition) ──────────────────────────────────────────────
# OpenAI-compatible ASR model. Qwen3-ASR-Flash accepts Telegram OGG/Opus directly.
ASR_MODEL=qwen3-asr-flash

# ─── Image generation ────────────────────────────────────────────────────────
# DashScope native image-synthesis model.
IMAGE_MODEL=qwen-image-3.0-pro
# Optional: explicit native DashScope base URL. Auto-derived from AI_BASE_URL
# (replaces "/compatible-mode/v1" with "/api/v1") when empty.
IMAGE_API_URL=
IMAGE_TIMEOUT=300

# ─── Admin ───────────────────────────────────────────────────────────────────
# Admin Telegram IDs (comma-separated)
ADMIN_IDS=

# ─── Limits & features ───────────────────────────────────────────────────────
# Max messages kept in the conversation context
MAX_HISTORY_LENGTH=30
# Daily question limit for whitelisted (non-admin) users
DAILY_LIMIT=10
# Lifetime free-trial messages for non-whitelisted users
GUEST_MESSAGE_LIMIT=0
# Allow anyone to try the bot (free trial)
ALLOW_GUEST_ACCESS=false
# Guest mode (Bot API 10.0): summon the bot with @username in ANY chat or group
# without adding it there. Enable "Guest Mode" in BotFather -> Bot Settings.
# With RICH_MESSAGES=true the single guest answer is a native rich message too.
ENABLE_GUEST_MODE=true
# A guest query allows exactly one reply: bound the work before answering (sec)
# Total budget for all steps, including recognition, chat and image generation.
# IMAGE_TIMEOUT does not extend this budget; use /image in private chat for slow jobs.
GUEST_TIMEOUT=300
# Recognize voice messages and answer with text or a generated image
ENABLE_VOICE=true
# Let the AI answer with a generated image when the user asks for one
ENABLE_IMAGE_GENERATION=true
# Maximum source audio size in bytes (7.5 MB; Base64 must fit 10 MB).
# Voice messages must also be at most 5 minutes long.
VOICE_MAX_BYTES=7500000

# ─── Rich messages (Bot API 10.1+) — primary delivery ────────────────────────
# AI answers are sent as native Telegram "rich messages": the model's GitHub-
# Flavored Markdown (tables, $$LaTeX$$ formulas, headings, task lists,
# footnotes) renders inside Telegram itself, up to 32768 characters per
# message (longer answers split at paragraph borders). Guest replies use the
# same rich content (InputRichMessageContent). With STREAM_RESPONSES=true the
# live preview in private chats is an animated ephemeral rich DRAFT — real
# Markdown while the model is talking, replaced by the final message.
# If Telegram rejects a rich message, delivery falls back to the legacy chain
# below automatically (Telegraph → PNG formulas → MarkdownV2 → HTML → plain).
# Requires aiogram >= 3.29 (pip install -U aiogram).
RICH_MESSAGES=true

# ─── Telegraph (fallback only) ───────────────────────────────────────────────
# Never used while rich delivery works — Telegram shows tables and LaTeX
# natively. Engages only when RICH_MESSAGES=false or a rich send was rejected:
# answers with Markdown tables / raw LaTeX are published as a Telegraph page
# and the user gets a link (with RENDER_FORMULA_IMAGES=true the PNG pipeline
# handles tables and display math first, so only un-renderable content
# triggers Telegraph). Every Telegraph failure (network blocked, page
# rejected) falls back to normal text delivery — nothing is lost.
# HTTPS_PROXY from the environment is honoured (telegra.ph is regionally blocked).
TELEGRAPH_ENABLED=true
TELEGRAPH_AUTHOR=Kapum ChatBot
TELEGRAPH_API_URL=https://api.telegra.ph
TELEGRAPH_TIMEOUT=20
# Placeholder: {url}.
TELEGRAPH_NOTICE=📄 This answer contains tables or formulas Telegram cannot display — the full version is published on Telegraph: {url}

# ─── Streaming answers ──────────────────────────────────────────────────────
# The reply appears progressively (private chats, groups and photo analysis;
# guest replies stay single-shot — a guest query allows exactly one result).
# With RICH_MESSAGES=true the private-chat preview is an animated rich DRAFT
# (sendRichMessageDraft): the partial answer arrives formatted, the draft is
# ephemeral and disappears by itself when the final rich message is sent. In
# groups drafts are unsupported — there one placeholder message is edited as
# plain text and replaced by the final answer.
# Any stream failure is retried as a regular single-shot request automatically.
STREAM_RESPONSES=true
# Seconds between draft/placeholder updates (Telegram tolerates ~1 per second
# per chat; values below 1 are clamped up).
STREAM_EDIT_INTERVAL=3
# Abort a stalled stream (no data for this many seconds) and fall back.
STREAM_STALL_TIMEOUT=60

# ─── "Ask another model" button ─────────────────────────────────────────────
# Under every answer in a private chat: re-asks the last question once with
# another model (default model stays unchanged). Attached to the rich message
# via reply_markup (rich messages support ordinary inline keyboards).
# Never shown in guest replies.
ASK_OTHER_MODEL=true

# The Telegraph API stopped accepting anonymous createPage (ACCESS_TOKEN_-
# INVALID). Give the bot an account pair, or leave both empty and it will
# create an anonymous account itself via createAccount and cache the token
# in TELEGRAPH_ACCOUNT_FILE (a secret - it is git-ignored).
TELEGRAPH_SHORT_NAME=
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_ACCOUNT_FILE=telegraph_account.json

# Simultaneous AI requests per user (extra messages get a "please wait" reply).
MAX_CONCURRENT_PER_USER=2
# Telegraph pages are PUBLIC. By default the title is generic ("AI answer");
# set true to use the user's question as the title.
TELEGRAPH_TITLE_FROM_QUESTION=false
